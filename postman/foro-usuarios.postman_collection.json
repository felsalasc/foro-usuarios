{
  "info": {
    "name": "Foro usuarios — recorrido verificable",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar completa en Collection Runner, en orden. Requiere administrador existente. Crea cuentas/datos de demostración y modifica solo sus registros nuevos; mantiene mínimos. Tokens y contraseñas de prueba solo en variables locales de ejecución. Oracle y persistencia se acreditan aparte; ver postman/README.md."
  },
  "item": [
    {
      "name": "01. Login del administrador existente",
      "request": {
        "method": "POST",
        "url": "{{usuariosBaseUrl}}/api/auth/login",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json, application/problem+json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{adminLoginJson}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('adminCorreo') || !pm.environment.get('adminPassword')) { pm.execution.setNextRequest(null); throw new Error('Configurar adminCorreo y adminPassword localmente antes de ejecutar'); }",
              "pm.variables.set('adminLoginJson', JSON.stringify({correo: pm.environment.get('adminCorreo'), password: pm.environment.get('adminPassword')}));",
              "const id = pm.variables.replaceIn('{{$guid}}').replace(/-/g, '').slice(0, 16);",
              "pm.variables.set('runId', id);",
              "pm.variables.set('passwordPrueba', 'Prueba-Aa9-' + pm.variables.replaceIn('{{$guid}}'));",
              "pm.variables.set('correoA', 'a-' + id + '@example.test'); pm.variables.set('correoB', 'b-' + id + '@example.test');",
              "pm.variables.set('correoTemporal', 'baja-' + id + '@example.test');",
              "pm.variables.set('tokenInvalido', 'token-invalido');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function verificar(nombre, fn) { pm.test(nombre, () => { try { fn(); } catch (error) { pm.execution.setNextRequest(null); throw error; } }); }",
              "try {",
              "verificar('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); } else {",
              "const r = pm.response.json();",
              "if (r.accessToken === undefined || r.accessToken === null) throw new Error('Falta el campo accessToken');",
              "if (pm.response.code === 200) pm.variables.set('adminToken', r.accessToken);",
              "if (r.usuario.id === undefined || r.usuario.id === null) throw new Error('Falta el campo usuario.id');",
              "if (pm.response.code === 200) pm.variables.set('adminId', r.usuario.id);",
              "verificar(\"Rol administrador\", () => { pm.expect(r.usuario.rol).to.eql('ADMINISTRADOR'); });",
              "}",
              "} catch (error) { pm.execution.setNextRequest(null); pm.test('Respuesta JSON con estructura válida', () => { throw error; }); }"
            ]
          }
        }
      ]
    },
    {
      "name": "02. Registrar usuario A",
      "request": {
        "method": "POST",
        "url": "{{usuariosBaseUrl}}/api/auth/registro",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json, application/problem+json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"nombre\": \"Usuario A Postman\", \"correo\": \"{{correoA}}\", \"password\": \"{{passwordPrueba}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function verificar(nombre, fn) { pm.test(nombre, () => { try { fn(); } catch (error) { pm.execution.setNextRequest(null); throw error; } }); }",
              "try {",
              "verificar('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code !== 201) { pm.execution.setNextRequest(null); } else {",
              "const r = pm.response.json();",
              "if (r.id === undefined || r.id === null) throw new Error('Falta el campo id');",
              "if (pm.response.code === 201) pm.variables.set('userAId', r.id);",
              "verificar(\"Sin secretos\", () => { pm.expect(r).not.to.have.property('password'); pm.expect(r).not.to.have.property('passwordHash'); });",
              "}",
              "} catch (error) { pm.execution.setNextRequest(null); pm.test('Respuesta JSON con estructura válida', () => { throw error; }); }"
            ]
          }
        }
      ]
    },
